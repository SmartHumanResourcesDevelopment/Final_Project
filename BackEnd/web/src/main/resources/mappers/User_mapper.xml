<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.smhrd.web.repository.UserMapper">

    <!-- 아이디 중복 -->
    <select id="existsByUserId" resultType="int">
        SELECT COUNT(*) FROM user_tbl WHERE user_id = #{id}
    </select>

    <!-- 회원가입 -->
    <insert id="insertUser">
    INSERT INTO user_tbl
    (user_id, username, password, phone_number, nickname, role, created_at)
    VALUES
    (#{id}, #{name}, #{password}, #{phone}, #{nickname}, #{role}, SYSDATE)
    </insert>

    <resultMap id="signUpResultMap" type="com.smhrd.web.DTO.SignUpRequest">
        <result property="user_id" column="USER_ID"/>
        <result property="username" column="USERNAME"/>
        <result property="password" column="PASSWORD"/>
        <result property="phone_number" column="PHONE_NUMBER"/>
        <result property="nickname" column="NICKNAME"/>
        <result property="role" column="ROLE"/>
    </resultMap>



    <!-- 로그인 -->
    <select id="findByUserId" resultMap="signUpResultMap">
        SELECT * FROM user_tbl WHERE user_id = #{user_input_id}
    </select>

    

    <!-- 유저 정보  수정 -->
    <update id="UserInfoUpdate" parameterType="com.smhrd.web.DTO.UserInfoUpdate_DTO">
    UPDATE user_tbl
    SET
        password = #{password},
        username = #{username},
        phone_number = #{phone_number},
        nickname = #{nickname}
    WHERE user_id = #{user_id}
    </update>

<!-- 유저 프로필 사진 변경 -->
   <update id="updateUserProfileById" parameterType="com.smhrd.web.DTO.UserProfileUpdateDTO">
        UPDATE USER_TBL
        SET    USERPROFILE = #{userProfile}
        WHERE  USER_ID    = #{userId}
    </update>


</mapper>